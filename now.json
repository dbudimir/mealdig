{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run pre-build && pnpm run build",
  "devCommand": "pnpm run dev",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/(.*)/",
      "destination": "/$1",
      "permanent": true
    }
  ]
}
